[Unit]
Description=刀塔经理 多人服务器（Dota2Manager）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=d2m
Group=d2m
WorkingDirectory=/opt/dota2manager
Environment=NODE_ENV=production
# 端口 / 存档目录 / 前端产物目录可按需修改；详见 server/index.ts 的参数说明
# 监听 80 端口（v0.4）：玩家直接打开 http://<服务器地址>/ ，不用写端口；云服务器安全组需放行 TCP 80。
#   80 < 1024 是特权端口：服务仍以普通用户 d2m 运行，只通过下方 AmbientCapabilities 授予「绑定低端口」这一项能力。
#   换回其他端口（如 8686）时改 --port 即可，大于 1024 的端口不需要这两行能力设置（留着也无害）。
# --also-port 8686：过渡期同时保留旧地址 http://<服务器地址>:8686/（同一个进程、同一批房间）。浏览器里的单机存档与多人身份
#   按网址分开保存，旧地址下的玩家可以回旧地址继续进行中的多人对局、导出单机存档后到新地址导入。过渡结束后删掉这个参数
#   （并在安全组关闭 8686）即可只留 80 端口。
# --public：公网模式，不向客户端发送也不打印任何内网地址，错误信息不含内部细节
# 在线统计（只允许服务器本机访问）：curl -s http://127.0.0.1/api/status；日志 journalctl -u dota2manager | grep 在线；
#           每日汇总 /opt/dota2manager-data/stats/online-YYYY-MM.jsonl（--stats-interval-min 调整日志间隔，默认 10 分钟）
ExecStart=/opt/dota2manager/node_modules/.bin/tsx server/index.ts --port 80 --also-port 8686 --host 0.0.0.0 --public --data /opt/dota2manager-data --dist /opt/dota2manager/dist --name 刀塔经理服务器
Restart=always
RestartSec=3
# 只有房间存档 / 在线统计目录 /opt/dota2manager-data 可写；程序目录 /opt/dota2manager（源码、node_modules、dist）运行时只读，
# 即使服务进程被攻破也无法改写自身代码（安装与构建由 scripts/deploy.sh 以 d2m 用户在服务之外完成）。
# tsx 的编译缓存写在临时目录（PrivateTmp 提供可写的私有 /tmp）。
ProtectSystem=strict
ReadWritePaths=/opt/dota2manager-data
PrivateTmp=true
NoNewPrivileges=true
# 绑定 80 端口：只给 CAP_NET_BIND_SERVICE 一项能力（Ambient 让非 root 的 d2m 进程直接持有它，与 NoNewPrivileges 兼容），
# 边界集也只留这一项，进程无法再获得其他任何特权。
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
